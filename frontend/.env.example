# VicTy frontend — environment template. Copy to `frontend/.env` and fill in.
# Everything here is PUBLIC: it ships to the browser. Never put a secret here
# (Jupiter key, AI key, DB, session secret live only in backend/.env).
# Rename with the framework's public prefix once the stack is chosen
# (e.g. NEXT_PUBLIC_API_URL for Next.js, VITE_API_URL for Vite).

# VicTy backend base URL — the frontend talks to Jupiter only through it
API_URL=http://localhost:3001

# Solana network the wallet must be on
SOLANA_CLUSTER=mainnet-beta
