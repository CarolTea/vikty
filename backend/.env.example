# VicTy backend — environment template. Copy to `backend/.env` and fill in; `.env` is never committed.
# Stack: Node.js 22 + TypeScript + Fastify.
# Every value here is BACKEND-ONLY. Public frontend config lives in the frontend's own env file.
# Secrets never reach the client or the logs.

# ----- App -----
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Frontend origins allowed by CORS, comma-separated (scheme + host, no path)
WEB_ORIGIN=http://localhost:3000
# Behind a hosting proxy (Render: true) so request.ip is the client's. Keep false locally.
TRUST_PROXY=false

# ----- Solana -----
# Deployment is mainnet. Use a private RPC provider; the public endpoint is rate-limited.
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ----- Jupiter (Swap V2 /order + /execute, Price V3, Tokens V2) -----
JUPITER_API_URL=https://api.jup.ag
JUPITER_API_KEY=

# ----- AI (thesis interpretation) — provider still to be chosen -----
# Until an adapter exists, free-text interpretations answer 503 AI_UNAVAILABLE (suggested theses work).
AI_API_KEY=

# ----- Database -----
# Migrations run automatically when the server starts.
DATABASE_URL=postgres://vikty:vikty@localhost:5432/vikty

# ----- Redis (rate limits and anonymous quota) -----
REDIS_URL=redis://localhost:6379

# ----- Auth: wallet sign-in via Privy -----
# The backend verifies the Privy access token sent as `Authorization: Bearer <token>`.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: the verification key from the Privy dashboard verifies tokens locally, with no network call.
PRIVY_VERIFICATION_KEY=

# ----- Anonymous session -----
# Signs the anonymous session cookie issued by GET /session (before any wallet is connected).
# At least 32 characters; generate with `openssl rand -base64 32`. Empty locally = random per restart.
SESSION_SECRET=

# ----- Bot protection (Cloudflare Turnstile, validated server-side) -----
# Required in production. Empty locally = every token passes (no call to Cloudflare).
TURNSTILE_SECRET_KEY=

# ----- Product limits -----
CONVICTION_MAX_CHARS=600
WALLET_DAILY_INTERPRETATIONS=20
